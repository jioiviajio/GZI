# ====================================================================
# Android / Gradle (Оригинальные правила)
# ====================================================================
*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Кэш Android Studio и логи
/.idea/
*.apk
*.ap_
*.aab

# ====================================================================
# Рабочие папки ИИ-Агентов и Клод-помощников (Убирает мусор со скрина)
# ====================================================================
.agents/
.claude/
**/_agents/
**/_claude/

# ====================================================================
# Firebase Cloud Functions (Node.js backend)
# ====================================================================
# Игнорируем локальные зависимости функций
**/functions/node_modules/
**/node_modules/

# Игнорируем логи Firebase
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firestore-debug.log*

# Тайные ключи сервисных аккаунтов (КРИТИЧЕСКИ ВАЖНО ДЛЯ БЕЗОПАСНОСТИ!)
# Если ты скачаешь .json ключ админа для Firebase, он случайно не улетит в паблик
*.json
!google-services.json
!package.json
!package-lock.json
